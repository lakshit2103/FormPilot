# ═══════════════════════════════════════════════════════
#  FormPilot AI — Environment Variables (v2.1)
#  Copy this file to backend/.env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────
APP_NAME=FormPilot AI
APP_ENV=development      # development | staging | production
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────
# Local PostgreSQL connection URL:
DATABASE_URL=postgresql+asyncpg://formpilot:formpilot@127.0.0.1:5432/formpilot
# Sync URL for Alembic migrations (psycopg2):
SYNC_DATABASE_URL=postgresql+psycopg2://formpilot:formpilot@127.0.0.1:5432/formpilot

# ── JWT / Security ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email ─────────────────────────────────────────────────
# Use "console" for development — verification links print to the terminal.
# Use "smtp" for production with a real SMTP service.
EMAIL_BACKEND=console   # console | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_ADDRESS=noreply@formpilot.ai
EMAILS_FROM_NAME=FormPilot AI

# ── Frontend URL ──────────────────────────────────────────
# Used in verification and reset email links
FRONTEND_URL=http://localhost:5173

# ── File Storage ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI / LLM ─────────────────────────────────────────────
# Required from Phase 4 onwards for LangGraph agents.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Rate Limiting ─────────────────────────────────────────
# Requests per minute per IP for auth endpoints
AUTH_RATE_LIMIT=20/minute

# ── Playwright / Browser ──────────────────────────────────
# true = show browser window (MVP), false = headless
PLAYWRIGHT_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
SESSION_INACTIVITY_TIMEOUT_HOURS=24
